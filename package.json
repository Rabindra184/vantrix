{
  "name": "perf-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @perfportal/api build && pnpm --filter @perfportal/worker build",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json"
  },
  "devDependencies": {
    "@perfportal/plugin-gatling": "workspace:*",
    "@perfportal/statistics": "workspace:*",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.0.0"
  }
}
