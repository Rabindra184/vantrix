# ═══════════════════════════════════════════════════════════════════════════
#  PerfPortal — on-prem deployment settings
#
#  cp infra/.env.example infra/.env   and edit. Compose reads infra/.env
#  automatically for `-f infra/docker-compose.yml`, because the project
#  directory is the one holding the compose file.
#
#  Everything here is read by infra/docker-compose.yml. Nothing else is.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required by the base services (postgres / redis / minio) ───────────────
# These three are `${VAR:?}` in the compose file, so a missing one fails
# before a single container starts, with the variable named.

PERFPORTAL_DB_PASSWORD=change-me-a-real-password
PERFPORTAL_S3_ACCESS_KEY=change-me-access
PERFPORTAL_S3_SECRET_KEY=change-me-secret-at-least-8-chars

# ─── Required by the `onprem` profile ──────────────────────────────────────

# Signs every session cookie. Generate with:   openssl rand -base64 32
# Anything under 32 characters is refused at startup, by design: Better Auth
# will not run on its built-in default under NODE_ENV=production, and
# apps/api/src/config.ts turns that into an immediate exit naming this
# variable rather than a container that starts and then fails every sign-in.
PERFPORTAL_AUTH_SECRET=

# The origin a BROWSER will actually use — scheme, host and port. This becomes
# BETTER_AUTH_URL, which is what the trusted-origin (CSRF) check is derived
# from, so a mismatch refuses your own sign-in as an invalid origin. It is the
# single most common on-prem misconfiguration.
#
#   behind TLS:      https://perf.example.com
#   plain localhost: http://localhost:3000
#
# NOTE ON TLS: the session cookie is minted `Secure` for every host EXCEPT
# localhost, 127.0.0.1 and [::1]. So a deployment reached by hostname over
# plain HTTP stores no cookie at all — sign-in appears to succeed and every
# later request 401s. Terminate TLS in front of the api service (the `tls`
# profile below ships a Caddy that does it), or reach it only on localhost.
PERFPORTAL_PUBLIC_URL=http://localhost:3000

# ─── The first account, created automatically on the first `up` ────────────
# The `bootstrap` service creates an org, a project, an API token and one
# admin account, then exits. It runs on every `up` and is idempotent: the org
# and project are upserted by slug, and an admin that already exists is reused
# and NEVER re-passworded.
PERFPORTAL_ORG_SLUG=perfportal
PERFPORTAL_PROJECT_SLUG=demo
PERFPORTAL_ADMIN_EMAIL=admin@perfportal.local

# ═══ SET THIS. LEAVING IT EMPTY SHIPS A PUBLISHED DEFAULT ═══
#
# Empty means the admin is created with the password `PerfPortal-Setup-2026`,
# written in this repository and therefore known to anyone who can reach your
# instance. Scanners try published defaults within hours of a host appearing.
#
# It exists because the alternative was worse: a deployment that came up
# healthy with no account that could sign in. It is only ever SEEDED — change
# the password in the UI and no later `up` will undo it — but on a host that
# is reachable from anywhere, set it here and skip that window entirely.
#
# Paste a real value; Compose does not run `$(…)` in this file. Generate one
# with:   openssl rand -hex 12
PERFPORTAL_ADMIN_PASSWORD=

# ─── The port the app is published on ──────────────────────────────────────
# Host side only; the container always listens on 3000. Set this to 80 and
# the instance is reachable at http://your-host with no port in the URL.
#
# If you do, write PERFPORTAL_PUBLIC_URL WITHOUT `:80` — a browser omits a
# default port from the Origin header, so `http://your-host:80` would never
# match what arrives and sign-in is refused as an invalid origin.
#
# Leave it at 3000 if you use the `tls` profile: caddy binds 80 and 443, two
# containers cannot publish the same host port, and behind TLS the api needs
# no published port at all.
PERFPORTAL_HTTP_PORT=3000

# ─── Serving over plain HTTP on a trusted network ──────────────────────────
# The session cookie is `Secure` unless PERFPORTAL_PUBLIC_URL is loopback, so
# a deployment reached at http://perfportal.internal:3000 will serve its login
# page, accept correct credentials, answer 200 — and then behave as though you
# never signed in, because the browser discarded the cookie. Nothing on screen
# explains it.
#
# Set this to `true` to serve sessions over plain HTTP instead.
#
#   USE IT ON A NETWORK YOU TRUST. A session cookie sent in the clear can be
#   read by anyone on the path between the browser and the server, and replayed.
#   For anything reachable beyond a trusted LAN, use the `tls` profile below
#   instead — it is the same amount of work and none of the exposure.
#
# Ignored when PERFPORTAL_PUBLIC_URL is `https://`, so it cannot downgrade a
# TLS deployment by being left switched on.
PERFPORTAL_ALLOW_INSECURE_COOKIES=false

# ─── Optional: the `tls` profile ───────────────────────────────────────────
# Caddy terminates TLS and reverse-proxies to api:3000. Set this to the same
# host as PERFPORTAL_PUBLIC_URL above, without the scheme.
#   docker compose -f infra/docker-compose.yml --profile onprem --profile tls up -d
PERFPORTAL_DOMAIN=localhost

# ─── Optional: the on-prem Gatling runner ──────────────────────────────────
# The runner claims queued jobs for ONE project. Both ids are UUIDs, and you
# only have them after the bootstrap step (see infra/README.md) has created an
# org and a project — so leave these empty on the first `up`, then fill them
# in and `docker compose ... up -d runner` again.
#
# Left empty the runner exits at startup naming RUNNER_ORG_ID, which is
# deliberate: a runner that cannot say whose jobs it runs must not run any.
PERFPORTAL_RUNNER_ORG_ID=
PERFPORTAL_RUNNER_PROJECT_ID=

# How long the runner keeps an uploaded artifact and its Gatling output.
PERFPORTAL_RUNNER_ARTIFACT_RETENTION_DAYS=30

# ─── Optional: the exact-statistics backfill ───────────────────────────────
# After an upgrade to exact statistics, the worker recomputes every run stored
# before it, in the background, one at a time and behind any upload that is
# waiting. Empty means on.
#
# Set `false` (exactly that word) to defer it, and finish the backlog when you
# choose with:
#   docker compose -f infra/docker-compose.yml --profile onprem run --rm worker pnpm recompute
PERFPORTAL_RECOMPUTE_ENABLED=

# How often the worker looks for runs still to recompute, in milliseconds.
# Empty, or anything under 1000 (a second), means every 10 minutes (600000).
PERFPORTAL_RECOMPUTE_SCAN_INTERVAL_MS=

# ─── Optional: verification and raw-log retention ──────────────────────────
# How many days after ingest a run's raw log becomes eligible for deletion.
# Empty means 90; 0 keeps raw logs for ever. A value that is not a whole
# number of days from 0 to 36500 stops the worker at startup.
#
# A log past it is deleted only once nothing needs it: the run has been
# verified (or settled as not verifiable), any estimated figures have been
# recomputed (or the backfill gave up on them), and its verification did not
# find a mismatch. So an upgrade deletes nothing the verifier or the backfill
# has yet to reach, and setting 0 before upgrading is optional
# (DEPLOYMENT.md, "Raw logs and verification").
PERFPORTAL_RAW_LOG_RETENTION_DAYS=

# The worker checks every run's stored statistics against its raw log after
# each upload and each recompute. Empty means on; `false` (exactly that word)
# defers it, and the backlog is checked once it is switched back on. While it
# is deferred, runs not yet verified read "Verifying…" and keep their raw logs.
PERFPORTAL_VERIFY_ENABLED=

# How often the worker looks for runs still to verify, in milliseconds.
# Empty, or anything under 1000 (a second), means every 10 minutes (600000).
PERFPORTAL_VERIFY_SCAN_INTERVAL_MS=

# ─── Optional: where Gatling's own report would differ ─────────────────────
# Each verification also replays the run's response times through Gatling's
# t-digest, and records where Gatling's HTML report would print a different
# percentile from the exact one. The image ships everything it needs; leave
# these empty unless you moved a jar.
#
# The tool jar. Empty means /opt/perfportal/gatling-method.jar.
PERFPORTAL_GATLING_METHOD_JAR=
# t-digest 3.3, the library Gatling's reports use. Empty means
# $RUNNER_GATLING_HOME/lib/t-digest-3.3.jar (/opt/gatling in the image).
PERFPORTAL_GATLING_METHOD_TDIGEST_JAR=
# Gatling breaks ties at random, so two reports of one run can differ; the
# method replays it this many times and keeps the range. A whole number from
# 1 to 200; empty or anything else means 16.
PERFPORTAL_GATLING_METHOD_SEEDS=
# How long the whole replay of one run (every seed) may take, in milliseconds,
# before it is stopped and the verification recorded without differences. Empty, anything under
# 1000, or anything over 2147483647 (the longest a timer can wait), means 300000 (five minutes).
PERFPORTAL_GATLING_METHOD_TIMEOUT_MS=
