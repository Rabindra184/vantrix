generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenancy columns (org_id, project_id) begin at the tables below the tenant
// root, not here. Org is the tenant root, so it carries no org_id of its
// own; Project's own id is its project identity, so it carries org_id but
// not project_id. Every table beneath these two is scoped by both.
model Org {
  id        String      @id @default(uuid()) @db.Uuid
  slug      String      @unique
  name      String
  createdAt DateTime    @default(now()) @map("created_at")
  projects  Project[]
  members   OrgMember[]

  @@map("org")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  slug      String
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tokens    ApiToken[]
  runs      Run[]
  slaRules  SlaRule[]
  runnerArtifacts RunnerArtifact[]
  runnerJobs RunnerJob[]

  @@unique([id, orgId])
  @@unique([orgId, slug])
  // TRIGRAM, FOR THE RUN LIST'S `?q=` SEARCH — see
  // `RunRepository.list` and migration 20260821200000_run_search_trigram.
  // A leading-wildcard ILIKE cannot use the b-tree above it; these can, and
  // they have to exist for EVERY column in that predicate's OR, because
  // PostgreSQL falls back to a sequential scan of the whole thing the moment
  // one branch is unindexable.
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "project_slug_trgm")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "project_name_trgm")
  @@map("project")
}

model RunnerArtifact {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  name            String
  filename        String
  kind            String
  simulationClass String   @map("simulation_class")
  gatlingVersion  String?  @map("gatling_version")
  sha256          String
  bytes           BigInt
  storagePath     String   @map("storage_path")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  jobs    RunnerJob[]

  @@unique([id, orgId, projectId])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("runner_artifact")
}

model RunnerJob {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  artifactId       String   @map("artifact_id") @db.Uuid
  runId            String?  @map("run_id") @db.Uuid
  status           String
  requestedBy      String   @map("requested_by")
  environment      String?
  branch           String?
  commitSha        String?  @map("commit_sha")
  javaOptions      String?  @map("java_options")
  systemProperties Json     @default("{}") @map("system_properties")
  logPath          String?  @map("log_path")
  error            Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  project  Project        @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  artifact RunnerArtifact @relation(fields: [artifactId, orgId, projectId], references: [id, orgId, projectId], onDelete: Restrict)
  run      Run?           @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([artifactId])
  @@index([runId])
  @@map("runner_job")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String
  /// Indexed lookup key, so verification is one row read plus one hash.
  prefix     String    @unique
  tokenHash  String    @map("token_hash")
  scopes     String[]
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_token")
}

model Run {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  status         String
  verdict        String?
  tool           String
  toolVersion    String?   @map("tool_version")
  /// Ingest metadata, frozen at accept time exactly like engineOptions and
  /// for the same reason: they describe the run that was submitted, and a
  /// later edit must not rewrite what was true when it ran. Never written by
  /// the worker. Null for every run created before migration
  /// 20260815000000_run_ingest_provenance, and for any run whose caller
  /// sent none of them.
  environment String?
  branch      String?
  commitSha   String? @map("commit_sha")
  /// The tool's own simulation identity and run description, from the run
  /// header. Null until the worker parses, and forever for a failed run.
  simulation  String?
  description String?
  /// The span the SERIES OFFSETS live in: run-header start to last event.
  /// Every bucket `startOffsetMs` is relative to the header start, so a time
  /// axis must span this or the final bucket falls outside the domain.
  /// NOT what the run page calls "Duration" -- see `activityMs`.
  durationMs  Int?     @map("duration_ms")
  /// The run's MEASURED span: first event (after warm-up) to last event, and
  /// exactly what every `throughputRps` divides by. This is the "Duration"
  /// the run page shows, and the one Gatling's own report agrees with.
  /// Null for runs ingested before 20260822090000_run_activity_ms; the lead-in
  /// it subtracts cannot be recovered from this row, so those fall back to
  /// `durationMs` rather than being backfilled with a guess.
  activityMs  Int?     @map("activity_ms")
  bundleKey      String    @map("bundle_key")
  bundleSha256   String    @map("bundle_sha256")
  bundleBytes    BigInt    @map("bundle_bytes")
  /// The byte cursor for a run fed by a stream rather than a bundle upload --
  /// how much of the log the platform has durably accepted so far. BIGINT,
  /// not INT: a log size cap is a product decision, not a storage one, and
  /// widening an INT later means a table rewrite. Unrelated to bundleBytes,
  /// which is the FINAL assembled size and stays 0 until close() sets it.
  streamOffset   BigInt    @default(0) @map("stream_offset")
  /// When this run's byte cursor LAST MOVED — set by RunRepository
  /// .advanceOffset on every accepted chunk, and null for a run that has
  /// never accepted one (including every run that was never live at all).
  ///
  /// This is what the sweeper measures 'running' staleness from, and it
  /// exists because nothing else on this row could. A `running` run is
  /// stale when its PRODUCER has stopped, and the only evidence of a live
  /// producer is bytes arriving; createdAt is the run's OPEN time, which for
  /// the soak tests this feature exists for is hours older than the last
  /// chunk and would mark every long run stale while it was still healthily
  /// streaming — the identical trap parsingStartedAt was added to fix one
  /// state over. parsingStartedAt itself is null throughout `running` by
  /// construction, so it cannot serve either.
  ///
  /// COALESCEd to createdAt by the sweeper for the null case, exactly as
  /// parsingStartedAt is: a run opened and then abandoned before its first
  /// chunk has no cursor movement to measure, and its open time is then the
  /// only honest reading of how long it has been silent.
  ///
  /// NOT cleared by releaseClose, unlike parsingStartedAt. That column
  /// describes an attempt that did not survive; this one describes bytes
  /// that did — the run really did last accept data when it says, and a
  /// close() that failed afterwards does not make that untrue or buy the
  /// producer a fresh silence budget.
  streamUpdatedAt DateTime? @map("stream_updated_at") @db.Timestamptz(3)
  idempotencyKey String?   @map("idempotency_key")
  /// When the platform received this run's bundle (accept time), NOT when
  /// the load test itself ran. Deliberately ingest time: see startedOn.
  /// TIMESTAMPTZ, like every instant in this model should be. As a bare
  /// `timestamp` it held UTC only by convention, and node-postgres decodes
  /// such a column in the process's LOCAL zone while Prisma decodes it as UTC
  /// — so the raw-pool trends query and the Prisma run query reported two
  /// different start times for one row on any non-UTC host. See the
  /// 20260817000000_run_timestamps_are_timestamptz migration.
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  /// The DATE of startedAt — the run_series_bucket partition key, carried
  /// here so it can be written at insert time. Deliberately an ingest date,
  /// not the load test's own start date: the worker only learns the real
  /// start after parsing, long after this row (and its partition) are
  /// chosen, and relocating already-written bucket rows across partitions
  /// to honor a later-discovered "true" date is not worth doing when
  /// partitioning exists for retention, not reporting — see toolStartedAt
  /// for the load test's own start, and spec §9.3.
  startedOn      DateTime  @map("started_on") @db.Date
  /// The load test's own start, from the tool's run header (e.g. Gatling's
  /// simulation.log), populated by the worker once parsing completes — null
  /// until then, and null forever for a run that never reaches 'complete'.
  /// This is what a human means by "when did the run happen"; startedAt is
  /// when the platform found out about it. Never used as a partition key
  /// (see startedOn) and never backdates run_series_bucket rows already
  /// written under the ingest-date partition.
  toolStartedAt  DateTime? @map("tool_started_at") @db.Timestamptz(3)
  ingestedAt     DateTime? @map("ingested_at") @db.Timestamptz(3)
  /// Row creation time — used by the sweeper (apps/worker/src/sweeper.ts) to
  /// detect a run stuck at 'pending' for too long. This coincides with
  /// startedAt today because both are `now()` at the same insert, but the
  /// two serve different purposes: startedAt is a fact about the run (when
  /// the platform received it) that the API exposes and the list endpoint
  /// can fall back to; createdAt is bookkeeping for this row's own
  /// lifecycle, internal to the sweeper's staleness query. They are not
  /// merged: a future change to either (e.g. startedAt one day reflecting a
  /// backfill-adjusted accept time) must not silently perturb the sweeper's
  /// unrelated staleness window.
  ///
  /// NO LONGER what the sweeper measures 'parsing' staleness from — see
  /// parsingStartedAt below for why createdAt was wrong for that one case.
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When this run MOST RECENTLY entered 'parsing' — set by both
  /// RunRepository.markParsing (the upload path) and .claimForClose (Task 9
  /// live path). The sweeper's 'parsing' staleness check reads THIS, falling
  /// back to createdAt only when null (a row from before this column
  /// existed, or — should it ever happen — one that reached 'parsing'
  /// through a path that forgot to set it).
  ///
  /// createdAt cannot serve this role for a live run: createdAt is OPEN
  /// time, and close() moves a run straight from 'running' to 'parsing' —
  /// often well past parsingStaleAfterMs (15 min default) after createdAt,
  /// since that is the ordinary case for the soak tests this feature exists
  /// for. Measuring from createdAt made every such run stale THE INSTANT it
  /// entered 'parsing', so the sweeper could re-enqueue it while close() was
  /// still assembling the log — racing PipelineService against a
  /// bundleSha256 close() had not finished writing yet.
  ///
  /// Cleared back to null by RunRepository.releaseClose when a failed
  /// close() reverts a run to 'running' — the parsing attempt that value
  /// described did not survive, so it should not linger as a stale reading
  /// on whatever attempt (or plain "still running") comes next.
  parsingStartedAt DateTime? @map("parsing_started_at") @db.Timestamptz(3)
  /// Frozen at accept time. Statistics are meaningless without the options
  /// that produced them, and a project changing its warm-up must not
  /// silently reinterpret its own history.
  engineOptions  Json      @map("engine_options")
  error          Json?
  /// The TOOL'S OWN assertions, decoded from the result file and re-evaluated
  /// against this run's statistics — Appendix A G-05. Null until the worker
  /// parses, and forever for a run that never reaches 'complete'; `[]` for a
  /// run whose simulation declared none.
  ///
  /// A COLUMN, NOT A TABLE, unlike `assertions` below. Those are SLA rule
  /// results: they reference a `rule_id`, outlive the rule's own edits through
  /// a snapshot, and are queried on their own. These are immutable run
  /// metadata written once by the tool — never filtered, never aggregated,
  /// never joined — so they belong beside `engine_options` for the same reason
  /// it is a column: they describe the run, they are not entities of their own.
  toolAssertions Json?     @map("tool_assertions")

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assertions RunAssertion[]
  runnerJobs RunnerJob[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, startedAt(sort: Desc)])
  @@index([status, createdAt])
  // The other six columns of the run list's `?q=` search. See the pair on
  // `Project` above for why every one of them needs its own index.
  @@index([simulation(ops: raw("gin_trgm_ops"))], type: Gin, map: "run_simulation_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "run_description_trgm")
  @@index([environment(ops: raw("gin_trgm_ops"))], type: Gin, map: "run_environment_trgm")
  @@index([branch(ops: raw("gin_trgm_ops"))], type: Gin, map: "run_branch_trgm")
  @@index([commitSha(ops: raw("gin_trgm_ops"))], type: Gin, map: "run_commit_sha_trgm")
  @@map("run")
}

model RunStat {
  id           String  @id @default(uuid()) @db.Uuid
  runId        String  @map("run_id") @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  scope        String
  name         String
  family       String
  count        Int
  okCount      Int     @map("ok_count")
  koCount      Int     @map("ko_count")
  errorRate    Float   @map("error_rate")
  minMs        Float   @map("min_ms")
  maxMs        Float   @map("max_ms")
  meanMs       Float   @map("mean_ms")
  stddevMs     Float   @map("stddev_ms")
  throughputRps Float  @map("throughput_rps")
  percentiles  Json
  sketch       Bytes
  sketchKind   String  @map("sketch_kind")
  histogramOk   Bytes?  @map("histogram_ok")
  histogramKo   Bytes?  @map("histogram_ko")
  histogramKind String? @map("histogram_kind")

  @@unique([runId, scope, name, family])
  @@index([runId])
  @@map("run_stat")
}

/// Partitioned by range on run_started_on — see migration 0001, hand-edited.
model RunSeriesBucket {
  runStartedOn  DateTime @map("run_started_on") @db.Date
  runId         String   @map("run_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  scope         String
  name          String
  /// Which measure this series is of. 'response_time' for run and request
  /// scope; a group carries 'group_cumulated' AND 'group_duration' under one
  /// name, which is why this is in the primary key.
  family        String
  startOffsetMs Int      @map("start_offset_ms")
  startedCount  Int      @map("started_count")
  endedCount    Int      @map("ended_count")
  okCount       Int      @map("ok_count")
  koCount       Int      @map("ko_count")
  /// The START-edge outcome split (requests/s, G-23). Nullable: rows written
  /// before migration 20260813120000 have no start-edge split at all, and
  /// null must not be read as zero.
  startedOkCount Int? @map("started_ok_count")
  startedKoCount Int? @map("started_ko_count")
  minMs         Float    @map("min_ms")
  maxMs         Float    @map("max_ms")
  meanMs        Float    @map("mean_ms")
  percentiles   Json
  percentilesOk Json? @map("percentiles_ok")
  percentilesKo Json? @map("percentiles_ko")
  /// Exact 1ms histograms of the same observations the bucket sketches hold,
  /// in a form a TIME WINDOW can merge — the frozen `percentiles` above cannot
  /// be re-aggregated, because the 95th of a union is not a function of two
  /// buckets' 95ths. Null for runs ingested before migration
  /// 20260816120000; that is what `windowable` reports.
  histogramOk   Bytes? @map("histogram_ok")
  histogramKo   Bytes? @map("histogram_ko")

  @@id([runStartedOn, runId, scope, name, family, startOffsetMs])
  @@map("run_series_bucket")
}

model RunError {
  id        String @id @default(uuid()) @db.Uuid
  runId     String @map("run_id") @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  scope     String
  name      String
  /// '' when isOther. A real message is never empty — the engine maps a
  /// missing one to '(no message)'.
  message   String
  /// The folded remainder — every message outside the top 200, summed. A
  /// column rather than a reserved `message` value, which collided with a
  /// genuine error of that name and failed the whole ingest. False on every
  /// row written before migration 20260816090000, including any that was the
  /// old sentinel: the two are indistinguishable, which was the defect.
  isOther   Boolean @map("is_other")
  count     Int

  @@unique([runId, scope, name, message, isOther])
  @@index([runId])
  @@map("run_error")
}

model SlaRule {
  id         String  @id @default(uuid()) @db.Uuid
  orgId      String  @map("org_id") @db.Uuid
  projectId  String  @map("project_id") @db.Uuid
  scope      String
  targetName String? @map("target_name")
  family     String
  metric     String
  comparator String
  threshold  Float
  enabled    Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled])
  @@map("sla_rule")
}

model RunUserBucket {
  runStartedOn  DateTime @map("run_started_on") @db.Date
  runId         String   @map("run_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  scenario      String
  startOffsetMs Int      @map("start_offset_ms")
  started       Int
  ended         Int
  maxConcurrent Int      @map("max_concurrent")

  @@id([runStartedOn, runId, scenario, startOffsetMs])
  @@map("run_user_bucket")
}

/// Partitioned by range on run_started_on — see migration
/// 20260815180000_run_error_bucket, hand-edited. Prisma cannot express
/// partitioning.
///
/// Run scope only, which is why there are no scope/name/family columns:
/// request-scope errors keep their flat rollup in run_error. INCLUDES WARM-UP,
/// unlike run_error — series do (PRD 7.4), so summing these will exceed the
/// errors table's total on any project with a warm-up window.
model RunErrorBucket {
  runStartedOn  DateTime @map("run_started_on") @db.Date
  runId         String   @map("run_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  startOffsetMs Int      @map("start_offset_ms")
  /// '' when isOther. A real message is never empty — the engine maps a
  /// missing one to '(no message)'.
  message       String
  /// The folded remainder — everything outside the five most frequent
  /// messages. A column rather than a magic `message` value, which would
  /// collide with a genuine error message of that text.
  isOther       Boolean  @map("is_other")
  count         Int
  /// Constant per run, denormalised deliberately: inferring a width from
  /// sparse offsets is systematically wrong. See the migration.
  bucketWidthMs Int      @map("bucket_width_ms")

  @@id([runStartedOn, runId, startOffsetMs, message, isOther])
  @@map("run_error_bucket")
}

/// Partitioned by range on sampled_on — see migration
/// 20260816140000_telemetry_sample, hand-edited. Prisma cannot express
/// partitioning.
///
/// NO run_id: a run does not exist in PerfPortal until its bundle is POSTed,
/// which happens after the test finishes, so telemetry can never carry one.
/// A run instead selects whatever samples overlap its own window. sampledAt
/// is the AGENT's clock and receivedAt is the SERVER's — kept apart so a
/// skewed agent clock is diagnosable rather than silently wrong.
model TelemetrySample {
  sampledOn       DateTime @map("sampled_on") @db.Date
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  host            String
  sampledAt       DateTime @map("sampled_at") @db.Timestamptz
  receivedAt      DateTime @map("received_at") @db.Timestamptz
  cpuUserMs       BigInt   @map("cpu_user_ms")
  cpuSystemMs     BigInt   @map("cpu_system_ms")
  cpuIdleMs       BigInt   @map("cpu_idle_ms")
  cpuIowaitMs     BigInt   @map("cpu_iowait_ms")
  netRxBytes      BigInt   @map("net_rx_bytes")
  netTxBytes      BigInt   @map("net_tx_bytes")
  tcpInSegs       BigInt   @map("tcp_in_segs")
  tcpOutSegs      BigInt   @map("tcp_out_segs")
  tcpRetransSegs  BigInt   @map("tcp_retrans_segs")
  tcpInErrs       BigInt   @map("tcp_in_errs")
  tcpActiveOpens  BigInt   @map("tcp_active_opens")
  tcpPassiveOpens BigInt   @map("tcp_passive_opens")
  memUsedBytes    BigInt   @map("mem_used_bytes")
  memTotalBytes   BigInt   @map("mem_total_bytes")
  /// Connection counts by TCP state, keyed by the KERNEL's state names.
  tcpStates       Json     @map("tcp_states")

  @@id([sampledOn, orgId, projectId, host, sampledAt])
  @@map("telemetry_sample")
}

model RunAssertion {
  id           String  @id @default(uuid()) @db.Uuid
  runId        String  @map("run_id") @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  ruleId       String  @map("rule_id") @db.Uuid
  /// The rule as it read at evaluation time. Editing a threshold must never
  /// rewrite the history of what passed.
  ruleSnapshot Json    @map("rule_snapshot")
  outcome      String
  actualValue  Float?  @map("actual_value")
  message      String

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("run_assertion")
}

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  orgMembers    OrgMember[]

  @@unique([email])
  @@map("user")
}

// Better Auth owns identity (User/Session/Account/Verification, above); org
// and project already exist and every query already filters on them (see
// note atop Org). This is the one new table joining the two: Better Auth
// answers "who is this?", org_member answers "what may they see?".
model OrgMember {
  userId    String   @map("user_id")
  orgId     String   @map("org_id") @db.Uuid
  /// Written, and deliberately unread until M6's RBAC. This project otherwise
  /// treats a write-only column as a defect (run_indicator.failed was deleted
  /// for exactly that). Admitted here because it is part of the tenancy key's
  /// shape and adding it later means migrating live membership rows.
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@map("org_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
